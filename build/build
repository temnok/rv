#!/usr/bin/env sh
set -e
cd $(dirname "$0")

rm -rf tmp output && mkdir tmp

docker run -ti \
    --cidfile tmp/.cid \
    --volume $(pwd)/input:/home/user/input:ro \
    --mount type=volume,src=rv-build-cache,dst=/home/user/cache \
    rv-toolchain \
    bash input/build

docker cp --quiet $(cat tmp/.cid):/home/user/output output
mv output/sha256.txt .

docker rm $(cat tmp/.cid) > /dev/null && rm -rf tmp
